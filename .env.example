# ==========================================
# Next.js Blog Environment Configuration
# Copy this file to .env.local for local dev:
# cp .env.example .env.local
# ==========================================

# Application URL (used for absolute share URLs and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Metadata
NEXT_PUBLIC_SITE_NAME="Fresh Ideas"
NEXT_PUBLIC_SITE_DESCRIPTION="Fresh Ideas for a Better Tomorrow"

# Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=hello@freshideas.blog

